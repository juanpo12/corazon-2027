# Variables para la venta de entradas — copiar a Vercel → Settings → Environment Variables
# (se puede pegar todo este texto junto en el campo "Key" y Vercel separa cada línea).
# Reemplazar cada valor de ejemplo. NUNCA subir al repo un archivo con los valores reales.
# Detalle de cada una en ENTRADAS.md.

# Dominio de la web, sin "/" al final
NEXT_PUBLIC_SITE_URL=https://www.conferenciadecorazonacorazon.com

# Mercado Pago (Tus integraciones → la aplicación)
# Primero el Access Token de PRUEBA; cuando todo funcione, cambiarlo por el de PRODUCCIÓN (APP_USR-...)
MP_ACCESS_TOKEN=pegar-aca-el-access-token
# Webhooks → Configurar notificaciones → clave secreta
MP_WEBHOOK_SECRET=pegar-aca-la-clave-secreta

# Supabase (Project Settings → Data API / API Keys)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_pegar-aca

# Resend (API Keys). EMAIL_FROM tiene que usar el dominio verificado en Resend
RESEND_API_KEY=re_pegar-aca
EMAIL_FROM=Corazón a Corazón <entradas@conferenciadecorazonacorazon.com>
# Opcional: a dónde llegan las respuestas al mail de las entradas
EMAIL_REPLY_TO=

# Control en la puerta (/control): clave del equipo, larga y difícil de adivinar
CONTROL_PIN=cambiar-por-una-clave-larga
# Texto largo al azar para firmar las sesiones (ej.: openssl rand -hex 32)
AUTH_SECRET=cambiar-por-64-caracteres-al-azar
